{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "EXPO_NO_DOTENV=1 EXPO_PUBLIC_AMBIENTE=demo EXPO_PUBLIC_DEMO=1 npx expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "rewrites": [{ "source": "/:path*", "destination": "/" }]
}

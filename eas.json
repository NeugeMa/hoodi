{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_AMBIENTE": "homologacao"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AMBIENTE": "producao"
      }
    },
    "demo": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO": "1",
        "EXPO_PUBLIC_AMBIENTE": "demo"
      }
    }
  }
}
